# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql+psycopg://pythagoras:changeme@localhost:5432/pythagoras
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=project-pythagoras

# --- Security / commercial-service settings (see SECURITY.md) ---
# When set, all /tracks/* endpoints require the header  X-API-Key: <value>.
# Leave unset for local dev / demo mode. Use a long random value in production.
PYTHAGORA_API_KEY=
# Comma-separated origins allowed to call the API cross-origin.
# Default (unset): localhost dev origins only.
PYTHAGORA_CORS_ORIGINS=
# Dedicated directory for uploaded audio/artwork (server-generated names).
PYTHAGORA_STORAGE_DIR=storage
# Upload + analysis limits.
PYTHAGORA_MAX_UPLOAD_BYTES=52428800
PYTHAGORA_MAX_ARTWORK_BYTES=10485760
PYTHAGORA_MAX_DURATION_SECONDS=900
# Per-IP rate limits (sliding window).
PYTHAGORA_UPLOAD_RATE_LIMIT=30
PYTHAGORA_API_RATE_LIMIT=1000
PYTHAGORA_RATE_WINDOW_SECONDS=60
# Simultaneous analysis jobs; uploads beyond the cap wait in a visible
# "queued" state instead of being rejected (batch uploads rely on this).
PYTHAGORA_MAX_CONCURRENT_JOBS=4
# Durable library file for projects / track metadata / notes.
# Default (unset): <PYTHAGORA_STORAGE_DIR>/library.json
PYTHAGORA_LIBRARY_FILE=
# Set to 1 only when serving over HTTPS (enables Strict-Transport-Security).
PYTHAGORA_ENABLE_HSTS=0
